ent-BaseToilet = унитаз
    .desc = НТ-451 — устройство для удаления мелких отходов, основанное на вращательном моменте. Этот выглядит удивительно чистым.

ent-ToiletEmpty = унитаз
    .desc = НТ-451 — устройство для удаления мелких отходов, основанное на вращательном моменте. Этот выглядит удивительно чистым.
    .suffix = Пустой

ent-ToiletDirtyWater = { ent-ToiletEmpty }
    .desc = { ent-ToiletEmpty.desc }
    .suffix = Грязная вода

ent-ToiletGoldenEmpty = золотой унитаз
    .desc = НТ-451-З — золотая версия аппарата. На боку написано, что он сделан из чистейшего меркурианского золота, а сиденье из натуральной кожи.
    .suffix = Пустой

ent-ToiletGoldenDirtyWater = { ent-ToiletGoldenEmpty }
    .suffix = Грязная вода, Цель кражи
    .desc = { ent-ToiletGoldenEmpty.desc }

ent-ConstructedToilet = Туалет
    .desc = HT-451 — устройство для утилизации мелких отходов на основе вращающего момента. Этот экземпляр выглядит на удивление чистым.
    .suffix = Собранный, не прочищается вантузом

ent-ToiletDirtyWaterFilled = { ent-ToiletEmpty }
    .desc = { ent-ToiletEmpty.desc }
    .suffix = Грязная вода, случайная добыча из бачка

ent-ToiletFilled = { ent-ToiletEmpty }
    .desc = { ent-ToiletEmpty.desc }
    .suffix = Пустой, случайная добыча из бачка
