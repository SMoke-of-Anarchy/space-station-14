ent-ActionRetractableItemArmBlade = Рука-клинок
    .desc = Сбросьте свою плоть и преобразуйте её в плотное лезвие.

ent-ActionChangelingDevour = [color=red]Поглотить[/color]
    .desc = Поглощайте сущность ваших жертв и впитывайте их личности и разум в себя.

ent-ActionChangelingTransform = [color=red]Трансформация[/color]
    .desc = Трансформируйтесь и обретайте личности тех, кого вы поглотили.

ent-ActionChangelingBiodegrade = Биодеградация
    .desc = Облейте кислотой свои путы и освободитесь. 
        
        Требует 20 единиц химикатов.

ent-ActionChangelingFakeMindshieldToggle = [color=green]Переключить поддельную защиту разума[/color]
    .desc = Включить или отключить отображение нашей защиты разума.

ent-ActionChangelingFleshtomb = Гробница из плоти
    .desc = Заключите тело в хрупкий кокон из плоти, который медленно вытягивает из него жизнь ради ДНК. 
        
        Требует 35 единиц химикатов.

ent-ActionChangelingLastResort = [color=red]Последний шанс[/color]
    .desc = В критический момент мы жертвуем нынешним телом: резко разрастаемся, пробиваем преграды и перерождаемся в слизня-головастика.

ent-ActionChangelingNightVision = Переключить ночное зрение
    .desc = Включает или отключает наше ночное зрение.

ent-ActionChangelingScreech = Пронзительный визг
    .desc = Мы издаём оглушительный визг, ослабляющий окружающих.

ent-ActionChangelingStasis = [color=red]Войти в стазис[/color]
    .desc = Войдите в регенеративный стазис, притворившись мёртвым, и восстановите все повреждения.

ent-ActionChangelingStasisWeak = { ent-ActionChangelingStasis }
    .desc = { ent-ActionChangelingStasis.desc }

ent-ActionChangelingStingArmblade = Укол клинком
    .desc = Незаметно ужальте цель, чтобы спустя некоторое время у неё вырос тупой клинок вместо руки. 
        
        Требует 50 единиц химикатов.

ent-ActionChangelingStingBlind = Ослепляющий укол
    .desc = Незаметно ужальте цель, ненадолго ухудшив её зрение. 
        
        Требует 30 единиц химикатов.

ent-ActionChangelingStingCryogenic = Криогенный укол
    .desc = Незаметно ужальте цель, значительно замедлив её передвижение. 
        
        Требует 30 единиц химикатов.

ent-ActionChangelingStingDna = Извлечь ДНК
    .desc = Тайно поглотите личность ничего не подозревающей жертвы. Не добавляет ДНК в запас и не продвигает выполнение цели. 
        
        Требует 50 единиц химикатов.

ent-ActionChangelingStingHemotoxin = Гемотоксичный укол
    .desc = Ужалите цель и введите ей опасную дозу различных токсинов, вызвав сильное кровотечение. 
        
        Требует 30 единиц химикатов.

ent-ActionChangelingStingLead = Смертельный укол
    .desc = Незаметно ужалите цель и введите смертельную дозу медленно действующего яда. 
        
        Требует 50 единиц химикатов.

ent-ActionChangelingStingMute = Безмолвный укол
    .desc = Незаметно ужалите цель и введите химикаты, лишающие её способности говорить. 
        
        Требует 30 единиц химикатов.

ent-ActionChangelingStore = Магазин способностей
    .desc = Открывает магазин способностей.

ent-ActionChangelingTakeOverCorpse = Захватить труп
    .desc = Заселите труп, чтобы вернуться к своему истинному облику.

ent-ActionChangelingVoiceMimic = Подражание голосу
    .desc = Измените свои голосовые связки, чтобы подражать голосу другого существа.

ent-ActionRetractableItemArmblade = Клинок вместо руки
    .desc = Сбросьте плоть и преобразуйте её в плотяной клинок. Можно убирать и выпускать.

ent-BaseActionChangelingSting = { "" }
    .desc = { "" }
